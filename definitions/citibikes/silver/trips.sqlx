config {
  type: "view",
  schema: "citibikes_silver",
}

-- Select relevant columns from the citibike_trips table
select
  tripduration,
  start_station_id,
  end_station_id,
  starttime,
  stoptime
from
    ${ref("citibike_trips")}
where
  --starttime >= '2022-01-01'  -- Filter for trips from 2022 onwards. --> No dataa
  starttime >= '2017-01-01'  -- Filter for trips from 2022 onwards